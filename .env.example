PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Cloudflare Turnstile — use the always-passes test key for local dev
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

RESEND_API_KEY=your_resend_api_key_here
RESEND_AUDIENCE_ID=your_resend_audience_id_here

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEWSLETTER_SECRET=your_random_secret_here
