{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aussie-pilot-guide",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aussie-pilot-guide-db",
			"database_id": "b4a856a0-fdaa-4de3-b411-eac604c55207"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "aussie-pilot-guide-media"
		}
	],
	// Astro session storage (used by the emdash admin). Created with:
	// npx wrangler kv namespace create SESSION
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "1d3509b8d5df41c58a40f059a295c150"
		}
	]
}