---
import { getEmDashCollection } from "emdash";
import Container from "../components/layouts/Container.astro";
import ContentGrid from "../components/layouts/sections/ContentGrid.astro";
import FeaturedContent from "../components/layouts/sections/FeaturedContent.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { attachMeta } from "../utils/meta";

const { entries: allPosts } = await getEmDashCollection("posts", {
    status: "published",
    orderBy: { published_at: "desc" },
});

const latestPosts = allPosts.slice(0, 3).map((post) => attachMeta(post));

const featured = allPosts
    .filter((item) => item.data.featured !== undefined && item.data.featured !== null)
    .sort((a, b) => Number(a.data.featured ?? 99) - Number(b.data.featured ?? 99));

const hasContent = featured.length > 0 || latestPosts.length > 0;
---

<BaseLayout
    title="Home"
    description="A student pilot's blog covering Australian aviation — training flights, theory, exams, and more."
>
    <Container class="space-y-24 py-12">
        {
            hasContent ? (
                <>
                    {featured.length > 0 && (
                        <FeaturedContent items={featured} />
                    )}

                    {latestPosts.length > 0 && (
                        <ContentGrid
                            title="Latest Posts"
                            href="/blog"
                            viewAllText="View all posts →"
                            items={latestPosts}
                        />
                    )}

                </>
            ) : (
                <EmptyState
                    title="Nothing here yet..."
                    message="Check back soon for new items!"
                />
            )
        }
    </Container>
</BaseLayout>
