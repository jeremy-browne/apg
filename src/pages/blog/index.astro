---
import { getEmDashCollection } from "emdash";
import ListLayout from "../../layouts/ListLayout.astro";
import { attachMeta } from "../../utils/meta";

const { entries } = await getEmDashCollection("posts", {
    status: "published",
    orderBy: { published_at: "desc" },
});
const posts = entries.map((p) => attachMeta(p));
---

<ListLayout
    title="Blog"
    description="A collection of my articles."
    ogImage="https://res.cloudinary.com/dellp9a4z/image/upload/v1756758389/og-blog_gnqmat.png"
    entries={posts}
/>
