---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layouts/Container.astro";
import Card from "../../components/content/Card.astro";
import Prose from "../../components/content/Prose.astro";
import { attachMeta } from "../../utils/meta";

export async function getStaticPaths() {
    const authors = await getCollection("authors");
    return authors.map((author) => ({
        params: { slug: author.id },
        props: { author },
    }));
}

const { author } = Astro.props;
const { Content } = await render(author);

const slugifyName = (name: string) =>
    name.toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, "");

const posts = (
    await getCollection(
        "blog",
        ({ data }) =>
            !data.draft &&
            data.authors.some((a) => slugifyName(a) === author.id),
    )
)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map((p) => attachMeta(p));
---

<BaseLayout
    title={author.data.name}
    description={`Articles by ${author.data.name}`}
>
    <Container class="py-12">
        <div class="mx-auto max-w-4xl">
            <h1 class="text-4xl font-bold">{author.data.name}</h1>
            {
                author.data.role && (
                    <p class="mt-2 text-lg text-gray-600 dark:text-gray-400">
                        {author.data.role}
                    </p>
                )
            }

            <Prose class:list={"mt-8"}>
                <Content />
            </Prose>
        </div>

        <div class="mt-16">
            <h2 class="mb-8 text-2xl font-bold">
                Articles by {author.data.name}
            </h2>
            {
                posts.length === 0 ? (
                    <p class="text-gray-600 dark:text-gray-400">
                        No articles yet.
                    </p>
                ) : (
                    <div class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
                        {posts.map((post) => (
                            <Card entry={post} />
                        ))}
                    </div>
                )
            }
        </div>
    </Container>
</BaseLayout>
