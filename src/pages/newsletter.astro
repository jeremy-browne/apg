---
export const prerender = false;

import { actions } from "astro:actions";
import NewsletterForm from "../components/forms/NewsletterForm.astro";
import Container from "../components/layouts/Container.astro";
import PageTitle from "../components/ui/PageTitle.astro";
import ResponseMessage from "../components/ui/form/ResponseMessage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const result = Astro.getActionResult(actions.newsletterSubscribe);

if (result?.data?.ok) {
    return Astro.redirect("/newsletter?success=1");
}

const confirmed = Astro.url.searchParams.get("confirmed");
---

<BaseLayout
    title="Newsletter"
    description="Subscribe to my newsletter for updates."
    ogImage="https://res.cloudinary.com/dellp9a4z/image/upload/v1756758390/og-newsletter_qht4nj.png"
>
    <Container class="mx-auto max-w-2xl py-12">
        <PageTitle title="Newsletter" />

        {confirmed === "1" && (
            <ResponseMessage title="You're subscribed!">
                <p class="mt-2">Your email has been confirmed. Welcome aboard — you'll hear from us when new content goes up.</p>
            </ResponseMessage>
        )}

        {confirmed === "expired" && (
            <ResponseMessage title="Link expired" intent="error">
                <p class="mt-2">That confirmation link has expired. Please subscribe again below to get a new one.</p>
            </ResponseMessage>
        )}

        {confirmed === "error" && (
            <ResponseMessage title="Something went wrong" intent="error">
                <p class="mt-2">We couldn't confirm your subscription. Please try again or contact us if the problem persists.</p>
            </ResponseMessage>
        )}

        {!confirmed && (
            <NewsletterForm
                variant="inline"
                showResult={true}
                showLegal={true}
                turnstileClass="flex justify-center"
                result={result}
            />
        )}

        {(confirmed === "expired" || confirmed === "error") && (
            <div class="mt-8">
                <NewsletterForm
                    variant="inline"
                    showLegal={true}
                    turnstileClass="flex justify-center"
                />
            </div>
        )}
    </Container>
</BaseLayout>

<script is:inline>
    (function () {
        const url = new URL(location.href);
        if (url.searchParams.has("_action")) {
            url.searchParams.delete("_action");
            history.replaceState(null, "", url);
        }
    })();
</script>
