---
import { getEntry, render } from "astro:content";
import Article from "../../components/content/Article.astro";
import FormattedDate from "../../components/content/FormattedDate.astro";
import Prose from "../../components/content/Prose.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { id } = Astro.params;
const docs = await getEntry("legal", id!);

if (!docs) return Astro.redirect("/404");

const { Content } = await render(docs);

const {
    data: { title, lastUpdated },
} = docs;
---

<BaseLayout title={docs.data.title} description={docs.data.description}>
    <Article>
        <header class="mb-12">
            <h1 class="mb-6 text-4xl font-bold sm:text-5xl sm:leading-snug">
                {title}
            </h1>

            {
                lastUpdated && (
                    <p class="text-lg">
                        <span class="font-bold">Last updated:</span>{" "}
                        <FormattedDate date={lastUpdated} />
                    </p>
                )
            }
        </header>

        <Prose>
            <Content />
        </Prose>
    </Article>
</BaseLayout>
