---
import "../styles/global.css";

import { Font } from "astro:assets";
import { SITE_SETTINGS } from "../site.config";

import TurnstileController from "../components/integrations/turnstile/TurnstileController.astro";
import SkipLinkBtn from "../components/ui/SkipLinkBtn.astro";
import ScrollToTop from "../components/ui/ScrollToTop.astro";
import Header from "../components/layouts/Header.astro";
import Footer from "../components/layouts/Footer.astro";
import SearchModal from "../components/layouts/SearchModal.astro";

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    alternateLinks?: Array<{ type: string; href: string; title?: string }>;
}

const {
    title = SITE_SETTINGS.title,
    description = SITE_SETTINGS.description,
    ogImage = SITE_SETTINGS.ogImages,
    alternateLinks,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />

        <Font cssVariable="--font-inter" />
        <Font cssVariable="--font-jet-brains-mono" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        {
            ogImage && (
                <meta
                    property="og:image"
                    content={new URL(ogImage, Astro.url)}
                />
            )
        }

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {
            ogImage && (
                <meta
                    name="twitter:image"
                    content={new URL(ogImage, Astro.url)}
                />
            )
        }

        <link rel="sitemap" href="sitemap-index.xml" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="RSS"
            href="rss.xml"
        />
        {alternateLinks?.map((link) => (
            <link rel="alternate" type={link.type} href={link.href} title={link.title} />
        ))}

        <script is:inline>
            try {
                const stored = localStorage.getItem("theme");
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                const isDark = stored ? stored === "dark" : prefersDark;
                document.documentElement.classList.toggle("dark", isDark);
            } catch {}
        </script>

        <TurnstileController />

        <script
            src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileAPILoad"
            defer
            referrerpolicy="origin"
            crossorigin="anonymous"></script>

        <script src="../utils/overlay.ts"></script>

        <!-- Google Analytics -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-SWHGXCSP5C"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-SWHGXCSP5C');

            // Conversion events (mark these as key events in GA4 Admin).
            // - Success pages: forms redirect to ?success=1 / ?confirmed=1.
            //   The param is stripped after sending so a refresh doesn't count twice.
            // - Any element with data-track="event_name" sends that event on click
            //   (optional data-track-label adds a label), e.g. affiliate links.
            (function () {
                var url = new URL(location.href);
                var page = url.pathname.replace(/\/$/, "");
                var sent = null;
                if (page === "/newsletter" && url.searchParams.get("success") === "1") {
                    sent = "success"; gtag("event", "newsletter_signup", { form_location: "newsletter_page" });
                } else if (page === "/newsletter" && url.searchParams.get("confirmed") === "1") {
                    sent = "confirmed"; gtag("event", "newsletter_confirm");
                } else if (page === "/contact" && url.searchParams.get("success") === "1") {
                    sent = "success"; gtag("event", "contact_submit");
                }
                if (sent) {
                    // Wait for load: page scripts (e.g. contact draft clearing) read the param too.
                    window.addEventListener("load", function () {
                        url.searchParams.delete(sent);
                        history.replaceState(history.state, "", url.pathname + url.search + url.hash);
                    });
                }

                document.addEventListener("click", function (e) {
                    var el = e.target instanceof Element ? e.target.closest("[data-track]") : null;
                    if (!el) return;
                    gtag("event", el.getAttribute("data-track"), {
                        label: el.getAttribute("data-track-label") || undefined,
                        link_url: el.getAttribute("href") || undefined,
                        page_path: location.pathname,
                    });
                });
            })();
        </script>
    </head>

    <body
        class="bg-white text-neutral-950 dark:bg-neutral-900 dark:text-neutral-50"
    >
        <SkipLinkBtn />

        <Header />

        <main id="main" class="min-h-[calc(100vh-12rem)]">
            <slot />
        </main>

        <Footer />

        <div
            id="overlay"
            class="pointer-events-none invisible fixed inset-0 z-40 bg-black/50 opacity-0 transition-all duration-500"
        >
        </div>

        <ScrollToTop />
        <SearchModal />
    </body>
</html>
