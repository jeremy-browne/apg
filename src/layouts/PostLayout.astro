---
import { getEmDashCollection } from "emdash";
import { PortableText } from "emdash/ui";
import PostMeta from "../components/content/PostMeta.astro";
import PostNavigation from "../components/content/PostNavigation.astro";
import Prose from "../components/content/Prose.astro";
import BuyMeACoffee from "../components/integrations/BuyMeACoffee.astro";
import MediumZoom from "../components/integrations/MediumZoom.astro";
import type { ContentEntry, WithMeta } from "../types";
import BaseLayout from "./BaseLayout.astro";

interface Props {
    entry: WithMeta<ContentEntry>;
}

const { entry } = Astro.props;
const slug = entry.data.slug ?? entry.id;

const { entries: allPosts } = await getEmDashCollection("posts", {
    status: "published",
    orderBy: { published_at: "desc" },
});
const postIndex = allPosts.findIndex((e) => e.data.slug === slug || e.id === entry.id);
const prevPost = allPosts[postIndex + 1] ? { ...allPosts[postIndex + 1], meta: { readingTimeText: "" } } : undefined;
const nextPost = allPosts[postIndex - 1] ? { ...allPosts[postIndex - 1], meta: { readingTimeText: "" } } : undefined;
---

<BaseLayout
    title={entry.data.title}
    description={entry.data.excerpt}
    alternateLinks={[{ type: "text/markdown", href: `/blog/${slug}.md`, title: `${entry.data.title} (Markdown)` }]}
>
    <MediumZoom />

    <div class="mx-auto max-w-350 px-4 sm:px-6 lg:px-8">
        <div class="xl:flex xl:gap-12">

            <!-- Main article -->
            <article class="min-w-0 flex-1 py-12">
                <div>
                    <PostMeta {entry} />
                    <Prose>
                        {entry.data.content && (
                            <PortableText value={entry.data.content} />
                        )}
                    </Prose>
                </div>

                <!-- Markdown link -->
                <div class="mt-8 border-t border-neutral-200 pt-6 dark:border-neutral-700">
                    <a
                        href={`/blog/${slug}.md`}
                        class="text-xs text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
                    >
                        View as plain text
                    </a>
                </div>

                <!-- Support me -->
                <div
                    class="my-12 rounded-lg border border-neutral-200 bg-neutral-50 p-8 text-center dark:border-neutral-700 dark:bg-neutral-900"
                >
                    <h3 class="text-xl font-semibold">
                        Did you find this post helpful?
                    </h3>
                    <p class="mt-2 text-gray-700 dark:text-gray-300">
                        A little support goes a long way in helping me create
                        more free, in-depth content like this.
                    </p>
                    <div class="mt-6">
                        <BuyMeACoffee class="inline-flex text-lg" />
                    </div>
                </div>

                <!-- Post Navigation -->
                <PostNavigation {prevPost} {nextPost} />
            </article>

        </div>
    </div>
</BaseLayout>
