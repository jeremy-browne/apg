---
import { getCollection, render } from "astro:content";
import PostMeta from "../components/content/PostMeta.astro";
import PostNavigation from "../components/content/PostNavigation.astro";
import Prose from "../components/content/Prose.astro";
import ToC from "../components/content/ToC/ToC.astro";
import BuyMeACoffee from "../components/integrations/BuyMeACoffee.astro";
import MediumZoom from "../components/integrations/MediumZoom.astro";
import type { ContentEntry, WithMeta } from "../types";
import BaseLayout from "./BaseLayout.astro";

interface Props {
    entry: WithMeta<ContentEntry>;
}

const { entry } = Astro.props;

const { Content, headings } = await render(entry);

const allPostsInCollection = await getCollection("blog", ({ data }) => !data.draft);

const postIndex = allPostsInCollection.findIndex((e) => e.id === entry.id);
const prevPost = allPostsInCollection[postIndex + 1];
const nextPost = allPostsInCollection[postIndex - 1];
---

<BaseLayout
    title={entry.data.title}
    description={entry.data.description}
    ogImage={entry.data.ogImage?.src}
    alternateLinks={[{ type: "text/markdown", href: `/blog/${entry.id}.md`, title: `${entry.data.title} (Markdown)` }]}
>
    <MediumZoom />

    <div class="mx-auto max-w-350 px-4 sm:px-6 lg:px-8">
        <div class="xl:flex xl:gap-12">

            <!-- Main article -->
            <article class="min-w-0 flex-1 py-12">
                <div data-pagefind-body>
                    <PostMeta {entry} />
                    <Prose>
                        <Content />
                    </Prose>
                </div>

                <!-- Markdown link -->
                <div class="mt-8 border-t border-neutral-200 pt-6 dark:border-neutral-700">
                    <a
                        href={`/blog/${entry.id}.md`}
                        class="text-xs text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
                    >
                        View as markdown
                    </a>
                </div>

                <!-- Support me -->
                <div
                    class="my-12 rounded-lg border border-neutral-200 bg-neutral-50 p-8 text-center dark:border-neutral-700 dark:bg-neutral-900"
                >
                    <h3 class="text-xl font-semibold">
                        Did you find this post helpful?
                    </h3>
                    <p class="mt-2 text-gray-700 dark:text-gray-300">
                        A little support goes a long way in helping me create
                        more free, in-depth content like this.
                    </p>
                    <div class="mt-6">
                        <BuyMeACoffee class="inline-flex text-lg" />
                    </div>
                </div>

                <!-- Post Navigation -->
                <PostNavigation {prevPost} {nextPost} />
            </article>

            <!-- Inline table of contents (xl and above) -->
            {
                headings.length > 0 && (
                    <aside class="hidden xl:block w-56 shrink-0 py-12">
                        <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
                            <ToC headings={headings} />
                        </div>
                    </aside>
                )
            }

        </div>
    </div>
</BaseLayout>
