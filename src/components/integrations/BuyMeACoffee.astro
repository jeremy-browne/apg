---
import BmcLogo from "../../assets/bmc-logo.svg";
import Button from "../ui/button/Button.astro";
import { cn } from "../../utils/styles";

interface Props {
    class?: string;
}

const { class: cls = "" } = Astro.props;
---

<Button
    href="https://buymeacoffee.com/aussiepilotguide"
    data-track="support_click"
    data-track-label="buy_me_a_coffee"
    class={cn("items-center gap-2", cls)}
>
    <BmcLogo class="bmc-logo size-6" />
    Shout me some AVGAS</Button
>

<style>
    .bmc-logo {
        fill: currentColor;
    }

    .bmc-logo :global(.bmc-fill) {
        fill: #facc15;
    }

    :global(html.dark) .bmc-logo :global(.bmc-fill) {
        fill: #fff;
    }
</style>
