---
import type { TocItem } from "../../../utils/toc";

interface Props {
    heading: TocItem;
}

const {
    heading: { depth, slug, subheadings, text },
} = Astro.props;
---

<li data-depth={depth}>
    <a
        href={`#${slug}`}
        class:list={[
            "toc-link block truncate py-1 text-sm leading-snug text-neutral-400 transition-colors duration-200 ease-out hover:text-neutral-600 dark:text-neutral-500 dark:hover:text-neutral-300",
            {
                "pl-3": depth === 3,
                "pl-6": depth === 4,
            },
        ]}
    >
        {text}
    </a>

    {
        subheadings && subheadings.length > 0 && (
            <ul class="mt-0.5">
                {subheadings.map((subheading) => (
                    <Astro.self heading={subheading} />
                ))}
            </ul>
        )
    }
</li>
