---
import { generateToc, type TocOptions } from "../../../utils/toc";
import type { MarkdownHeading } from "astro";
import ToCHeading from "./ToCHeading.astro";

interface Props {
    headings: MarkdownHeading[];
    options?: TocOptions;
}

const { headings, options } = Astro.props;
const toc = generateToc(headings, options);

if (toc.length === 0) return null;
---

<toc-inline>
    <nav aria-label="Table of contents">
        <p
            class="mb-3 text-xs font-semibold tracking-wider text-neutral-400 uppercase dark:text-neutral-500"
        >
            On this page
        </p>
        <ul>
            {toc.map((heading) => <ToCHeading heading={heading} />)}
        </ul>
    </nav>
</toc-inline>

<style is:global>
    .toc-link.toc-active {
        color: #171717;
        font-weight: 500;
    }
    .dark .toc-link.toc-active {
        color: #f5f5f5;
    }
</style>

<script>
    class TocInline extends HTMLElement {
        articleHeadings: HTMLElement[] = [];
        tocLinks: HTMLAnchorElement[] = [];
        activeIndex = -1;
        ticking = false;
        headerH = 64;

        updateActiveLink = () => {
            let currentBest = -1;
            const triggerLine = window.innerHeight * 0.2 + this.headerH;

            for (let i = 0; i < this.articleHeadings.length; i++) {
                if (
                    this.articleHeadings[i].getBoundingClientRect().top <=
                    triggerLine
                ) {
                    currentBest = i;
                }
            }

            if (currentBest !== this.activeIndex) {
                this.tocLinks.forEach((link, i) => {
                    link.classList.toggle("toc-active", i === currentBest);
                });
                this.activeIndex = currentBest;
            }
        };

        onScroll = () => {
            if (!this.ticking) {
                window.requestAnimationFrame(() => {
                    this.updateActiveLink();
                    this.ticking = false;
                });
                this.ticking = true;
            }
        };

        connectedCallback() {
            const header = document.querySelector("header");
            if (header) this.headerH = header.getBoundingClientRect().height;

            this.articleHeadings = Array.from(
                document.querySelectorAll(
                    "article h2, article h3, article h4",
                ),
            );
            this.tocLinks = Array.from(
                this.querySelectorAll("a.toc-link"),
            );

            if (
                this.articleHeadings.length === 0 ||
                this.tocLinks.length === 0
            )
                return;

            this.updateActiveLink();
            document.addEventListener("scroll", this.onScroll, {
                passive: true,
            });
        }

        disconnectedCallback() {
            document.removeEventListener("scroll", this.onScroll);
        }
    }

    customElements.define("toc-inline", TocInline);
</script>
