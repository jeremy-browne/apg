---
import { getCollection } from "astro:content";
import FeaturedTag from "./FeaturedTag.astro";
import FormattedDate from "./FormattedDate.astro";
import Series from "./Series.astro";
import OptimizedImage from "../ui/OptimizedImage.astro";
import Tooltip from "../ui/Tooltip.astro";
import { formatDate } from "../../utils/formatDate";
import { Icon } from "astro-icon/components";
import type { ContentEntry, ImageLoading, WithMeta } from "../../types";
import { SITE_SETTINGS } from "../../site.config";

interface Props {
    entry: WithMeta<ContentEntry>;
    loading?: ImageLoading;
    fetchpriority?: "high" | "low" | "auto";
}

const { entry, loading = "eager", fetchpriority = "high" } = Astro.props;

const { data, meta } = entry;
const { title, publishedAt, updatedAt, bylines, featured, featured_image, series } = data;
const { readingTimeText } = meta || {};

const knownAuthorIds = new Set(
    (await getCollection("authors")).map((a) => a.id),
);

const resolvedAuthors = ((bylines ?? []).length > 0
    ? (bylines ?? []).map((credit) => ({
          name: credit.byline.displayName,
          slug: credit.byline.slug,
          hasProfile: knownAuthorIds.has(credit.byline.slug),
      }))
    : [{ name: SITE_SETTINGS.owner, slug: "", hasProfile: false }]);
---

<header class="mb-12">
    {featured && <FeaturedTag />}

    <h1
        class="mb-6 text-4xl font-bold sm:text-5xl sm:leading-snug"
    >
        {title}
    </h1>

    <div class="flex flex-wrap gap-6 text-gray-700 dark:text-gray-300">
        <div class="flex items-center gap-2">
            <Icon name="lucide:user-pen" class="size-5" />
            <span>
                {
                    resolvedAuthors.map(({ name, slug, hasProfile }, i) => (
                        <>
                            {i > 0 && ", "}
                            {hasProfile ? (
                                <a
                                    href={`/authors/${slug}`}
                                    class="hover:text-blue-500 dark:hover:text-yellow-400 transition-colors duration-200"
                                >
                                    {name}
                                </a>
                            ) : (
                                <span>{name}</span>
                            )}
                        </>
                    ))
                }
            </span>
        </div>
        <div class="flex items-center gap-2">
            <Icon name="lucide:calendar" class="size-5" />
            {
                updatedAt && publishedAt && updatedAt.valueOf() !== publishedAt.valueOf() ? (
                    <Tooltip
                        id={`pubdate-${entry.id}`}
                        label={`Published: ${formatDate(publishedAt)}`}
                    >
                        <span class="cursor-help border-b border-dashed border-current">
                            Updated: <FormattedDate date={updatedAt} />
                        </span>
                    </Tooltip>
                ) : (
                    <span>
                        {publishedAt && <FormattedDate date={publishedAt} />}
                    </span>
                )
            }
            {
                readingTimeText && (
                    <>
                        <span>&middot;</span>
                        <span>{readingTimeText}</span>
                    </>
                )
            }
        </div>
    </div>

    {series && <Series {series} class="mt-6" />}

    {featured_image?.src && (
        <OptimizedImage
            src={featured_image.src}
            alt={featured_image.alt ?? ""}
            {loading}
            {fetchpriority}
            wrapperClass="mt-6 aspect-video rounded-xl"
            imageClass="no-zoom transition duration-250 ease-out group-hover:scale-105 group-active:scale-105"
        />
    )}
</header>
