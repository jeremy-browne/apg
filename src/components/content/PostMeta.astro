---
import { getCollection, getEntry } from "astro:content";
import FeaturedTag from "./FeaturedTag.astro";
import FormattedDate from "./FormattedDate.astro";
import PostCopyright from "./PostCopyright.astro";
import Series from "./Series.astro";
import Tags from "./Tags.astro";
import OptimizedImage from "../ui/OptimizedImage.astro";
import Tooltip from "../ui/Tooltip.astro";
import { formatDate } from "../../utils/formatDate";
import { Icon } from "astro-icon/components";
import type { ContentEntry, ImageLoading, WithMeta } from "../../types";
import { SITE_SETTINGS } from "../../site.config";

interface Props {
    entry: WithMeta<ContentEntry>;
    loading?: ImageLoading;
    fetchpriority?: "high" | "low" | "auto";
}

const { entry, loading = "eager", fetchpriority = "high" } = Astro.props;

const { data, meta } = entry;
const { title, pubDate, updatedDate, authors, featured, image, series, tags } =
    data;
const { readingTimeText } = meta || {};

const license = data.license ? await getEntry(data.license) : undefined;

const knownAuthorIds = new Set(
    (await getCollection("authors")).map((a) => a.id),
);

const slugifyName = (name: string) =>
    name.toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, "");

const resolvedAuthors = (authors.length > 0 ? authors : [SITE_SETTINGS.owner]).map(
    (name) => {
        const slug = slugifyName(name);
        const hasProfile = knownAuthorIds.has(slug);
        if (!hasProfile) {
            console.warn(
                `[authors] Post "${entry.id}" references author "${name}" but no profile found at src/content/authors/${slug}.md`,
            );
        }
        return { name, slug, hasProfile };
    },
);

---

<header class="mb-12">
    {featured && <FeaturedTag />}

    <h1
        data-pagefind-meta="title"
        class="mb-6 text-4xl font-bold sm:text-5xl sm:leading-snug"
    >
        {title}
    </h1>

    <div class="flex flex-wrap gap-6 text-gray-700 dark:text-gray-300">
        <div class="flex items-center gap-2">
            <Icon name="lucide:user-pen" class="size-5" />
            <span>
                {
                    resolvedAuthors.map(({ name, slug, hasProfile }, i) => (
                        <>
                            {i > 0 && ", "}
                            {hasProfile ? (
                                <a
                                    href={`/authors/${slug}`}
                                    class="hover:text-blue-500 dark:hover:text-yellow-400 transition-colors duration-200"
                                >
                                    {name}
                                </a>
                            ) : (
                                <span>{name}</span>
                            )}
                        </>
                    ))
                }
            </span>
        </div>
        <div class="flex items-center gap-2">
            <Icon name="lucide:calendar" class="size-5" />
            {
                updatedDate ? (
                    <Tooltip
                        id={`pubdate-${entry.id}`}
                        label={`Published: ${formatDate(pubDate)}`}
                    >
                        <span class="cursor-help border-b border-dashed border-current">
                            Updated: <FormattedDate date={updatedDate} />
                        </span>
                    </Tooltip>
                ) : (
                    <span>
                        <FormattedDate date={pubDate} />
                    </span>
                )
            }
            {
                readingTimeText && (
                    <>
                        <span>&middot;</span>
                        <span>{readingTimeText}</span>
                    </>
                )
            }
        </div>

        {license && <PostCopyright {license} />}
    </div>

    {series && <Series {series} class="mt-6" />}
    {tags.length > 0 && <Tags {tags} class="mt-6" />}


    {image && (
        <OptimizedImage
            data-pagefind-meta="image[src], image_alt[alt]"
            src={image.src}
            alt={image.alt}
            {loading}
            {fetchpriority}
            wrapperClass="mt-6 aspect-video rounded-xl"
            imageClass="no-zoom transition duration-250 ease-out group-hover:scale-105 group-active:scale-105"
        />
    )}
</header>
