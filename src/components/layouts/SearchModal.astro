---
import { Icon } from "astro-icon/components";
---

<dialog id="search-modal" aria-label="Search">
    <div class="flex flex-col">
        <div
            class="flex items-center gap-2 border-b border-neutral-200 px-4 py-3 dark:border-neutral-700"
        >
            <Icon
                name="lucide:search"
                class="size-5 shrink-0 text-neutral-400"
            />
            <input
                id="search-input"
                type="search"
                placeholder="Search posts…"
                autocomplete="off"
                aria-label="Search posts"
                class="w-full bg-transparent text-base outline-none placeholder:text-neutral-400"
            />
            <button
                id="close-search"
                type="button"
                class="rounded-md p-1 text-neutral-500 transition-colors hover:text-neutral-900 dark:hover:text-neutral-100"
                aria-label="Close search"
            >
                <Icon name="lucide:x" class="size-5" />
            </button>
        </div>
        <ul
            id="search-results"
            class="max-h-[60vh] overflow-y-auto px-2 py-2 empty:hidden"
        >
        </ul>
        <p
            id="search-empty"
            class="hidden px-4 py-6 text-center text-sm text-neutral-500 dark:text-neutral-400"
        >
            No results.
        </p>
    </div>
</dialog>

<style>
    dialog {
        position: fixed;
        top: 5rem;
        left: 50%;
        transform: translateX(-50%);
        width: min(calc(100vw - 2rem), 42rem);
        max-height: calc(100vh - 7rem);
        border: none;
        border-radius: 0.75rem;
        padding: 0;
        overflow: hidden;
        box-shadow:
            0 25px 50px -12px rgba(0, 0, 0, 0.25),
            0 0 0 1px rgba(0, 0, 0, 0.05);
        background-color: white;
    }

    :global(.dark) dialog {
        background-color: #171717;
        box-shadow:
            0 25px 50px -12px rgba(0, 0, 0, 0.6),
            0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    dialog::backdrop {
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(2px);
    }

    dialog[open] {
        animation: modal-in 180ms ease-out;
    }

    @keyframes modal-in {
        from {
            opacity: 0;
            transform: translateX(-50%) translateY(-0.375rem);
        }
        to {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    }
</style>

<script>
    import { renderResults } from "../../scripts/search.ts";

    const modal = document.getElementById("search-modal") as HTMLDialogElement;
    const closeBtn = document.getElementById("close-search");
    const input = document.getElementById("search-input") as HTMLInputElement;
    const results = document.getElementById(
        "search-results",
    ) as HTMLUListElement;
    const empty = document.getElementById("search-empty") as HTMLElement;

    let debounce: ReturnType<typeof setTimeout> | undefined;
    let seq = 0;

    const runSearch = async (query: string) => {
        const q = query.trim();
        if (q.length < 2) {
            results.replaceChildren();
            empty.classList.add("hidden");
            return;
        }
        const current = ++seq;
        try {
            const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
            const { results: items } = await res.json();
            if (current !== seq) return; // a newer query already returned
            renderResults(results, empty, items);
        } catch {
            if (current === seq) renderResults(results, empty, []);
        }
    };

    input?.addEventListener("input", () => {
        clearTimeout(debounce);
        debounce = setTimeout(() => runSearch(input.value), 200);
    });

    const openModal = () => {
        modal.showModal();
        document.body.style.overflow = "hidden";
        requestAnimationFrame(() => input?.focus());
    };

    const closeModal = () => modal.close();

    // Restore scroll when dialog closes (covers Escape key too)
    modal.addEventListener("close", () => {
        document.body.style.overflow = "";
    });

    // Close on backdrop click (fires on <dialog> when clicking outside content)
    modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
    });

    closeBtn?.addEventListener("click", closeModal);

    // Triggered by the header search button
    document.addEventListener("open-search", openModal);

    // Global "/" shortcut
    document.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key !== "/") return;
        const target = e.target as HTMLElement;
        if (
            target.tagName === "INPUT" ||
            target.tagName === "TEXTAREA" ||
            target.isContentEditable
        )
            return;
        e.preventDefault();
        openModal();
    });
</script>
